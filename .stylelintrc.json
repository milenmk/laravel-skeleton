{
    "extends": [
        "stylelint-config-standard"
    ],
    "rules": {
        "import-notation": "string",
        "nesting-selector-no-missing-scoping-root": false,
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "plugin",
                    "tailwind",
                    "apply",
                    "variants",
                    "responsive",
                    "screen",
                    "source",
                    "theme",
                    "custom-variant"
                ]
            }
        ],
        "no-descending-specificity": null,
        "selector-class-pattern": [
            "^[a-z][a-z0-9-]*(?:__[a-z0-9-]+)?(?:--[a-z0-9-]+)?$",
            {
                "resolveNestedSelectors": true
            }
        ]
    }
}
